{
  "name": "preferans-engine",
  "version": "0.1.0",
  "description": "Pure TypeScript engine for Preferans — no DOM, no UI, no backend",
  "type": "module",
  "main": "src/game.ts",
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "play": "node --import tsx ../tools/play-cli.ts",
    "diag": "node --import tsx tools/diag-scoring.ts"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
